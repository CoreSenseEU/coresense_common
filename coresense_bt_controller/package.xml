<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>coresense_bt_controller</name>
  <version>0.8.0</version>
  <description>CoreSense BT Controller is a fork of the BT Executor node, patched to allow loading and executing trees at runtime as a service</description>
  <maintainer email="AGabriel@4d6.de">Alex Quin Averie Gabriel</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>pluginlib</depend>

  <depend>behaviortree_cpp</depend>
  <depend>behaviortree_ros2</depend>
  <depend>btcpp_ros2_interfaces</depend>

  <depend>coresense_msgs</depend>
  <depend>triplestar_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
